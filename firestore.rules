rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. User Profile and Nested Subcollections Matches
    match /users/{userId} {
      // Users can get, create and update their own profiles
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 150
        && (request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30));

      // Nested shipping addresses
      match /addresses/{addressId} {
        allow list, get: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(addressId);
      }

      // Nested cake orders
      match /orders/{orderId} {
        allow list, get: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(orderId);
      }
    }
  }
}
